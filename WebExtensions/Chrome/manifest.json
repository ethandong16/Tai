{
    "name": "Tai WinUI3 网页统计助手",
    "short_name": "Tai WinUI3",
    "description": "配合 Tai WinUI3 修改版，统计当前活动网页的本地浏览时长；数据仅发送到本机 Tai。",
    "version": "1.1.0",
    "homepage_url": "https://github.com/ethandong16/Tai.WinUI",
    "icons": {
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "manifest_version": 3,
    "minimum_chrome_version": "116",
    "action": {
        "default_icon": "icons/socket-inactive.png"
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "permissions": [
        "tabs"
    ]
}
