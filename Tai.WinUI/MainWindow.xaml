<Window
    x:Class="Tai.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tai.WinUI">
    <Grid Background="{StaticResource TaiPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32" Padding="16,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{StaticResource TaiAccentBrush}" />
                <TextBlock Text="Tai" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                <TextBlock Text="时间统计" FontSize="12" Foreground="{StaticResource TaiSecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <local:MainPage x:Name="RootPage" Grid.Row="1" />
    </Grid>
</Window>
