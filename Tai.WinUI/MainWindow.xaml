<Window
    x:Class="Tai.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource TaiPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32" Padding="16,0,148,0" Background="{StaticResource TaiCardBackgroundBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image x:Name="TitleBarLogo" Source="ms-appx:///Resources/Icons/tai.png" Width="18" Height="18" />
                <TextBlock Text="Tai" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                <TextBlock Text="时间统计" FontSize="12" Foreground="{StaticResource TaiSecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StartupError" Grid.Row="1" IsOpen="False" Severity="Error"
                 Title="统计服务启动失败" Message="暂时无法记录使用时间。请查看 Log/startup.log 中的错误详情。" />
        <Frame x:Name="RootFrame" Grid.Row="2" />
    </Grid>
</Window>
