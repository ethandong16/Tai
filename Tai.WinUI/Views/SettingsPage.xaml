<Page x:Class="Tai.WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" Background="Transparent">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageStack.Margin" Value="24,8,28,32" />
                        <Setter Target="SettingsTabs.Margin" Value="0" />
                        <Setter Target="StartPagePicker.(Grid.Row)" Value="0" />
                        <Setter Target="StartPagePicker.(Grid.Column)" Value="1" />
                        <Setter Target="StartPagePicker.HorizontalAlignment" Value="Right" />
                        <Setter Target="StartPagePicker.Margin" Value="0" />
                        <Setter Target="ThemePicker.(Grid.Row)" Value="0" />
                        <Setter Target="ThemePicker.(Grid.Column)" Value="1" />
                        <Setter Target="ThemePicker.HorizontalAlignment" Value="Right" />
                        <Setter Target="ThemePicker.Margin" Value="0" />
                        <Setter Target="LanguagePicker.(Grid.Row)" Value="0" />
                        <Setter Target="LanguagePicker.(Grid.Column)" Value="1" />
                        <Setter Target="LanguagePicker.HorizontalAlignment" Value="Right" />
                        <Setter Target="LanguagePicker.Margin" Value="0" />
                        <Setter Target="CategoryIntervalPicker.(Grid.Row)" Value="0" />
                        <Setter Target="CategoryIntervalPicker.(Grid.Column)" Value="1" />
                        <Setter Target="CategoryIntervalPicker.HorizontalAlignment" Value="Right" />
                        <Setter Target="CategoryIntervalPicker.Margin" Value="0" />
                        <Setter Target="DeleteStartPicker.(Grid.Row)" Value="0" />
                        <Setter Target="DeleteStartPicker.(Grid.Column)" Value="0" />
                        <Setter Target="DeleteStartPicker.Margin" Value="0" />
                        <Setter Target="DeleteEndPicker.(Grid.Row)" Value="0" />
                        <Setter Target="DeleteEndPicker.(Grid.Column)" Value="1" />
                        <Setter Target="DeleteEndPicker.Margin" Value="0" />
                        <Setter Target="DeleteDataButton.(Grid.Row)" Value="0" />
                        <Setter Target="DeleteDataButton.(Grid.Column)" Value="2" />
                        <Setter Target="DeleteDataButton.Margin" Value="0" />
                        <Setter Target="ExportStartPicker.(Grid.Row)" Value="0" />
                        <Setter Target="ExportStartPicker.(Grid.Column)" Value="0" />
                        <Setter Target="ExportStartPicker.Margin" Value="0" />
                        <Setter Target="ExportEndPicker.(Grid.Row)" Value="0" />
                        <Setter Target="ExportEndPicker.(Grid.Column)" Value="1" />
                        <Setter Target="ExportEndPicker.Margin" Value="0" />
                        <Setter Target="ExportDataButton.(Grid.Row)" Value="0" />
                        <Setter Target="ExportDataButton.(Grid.Column)" Value="2" />
                        <Setter Target="ExportDataButton.Margin" Value="0" />
                        <Setter Target="DataActions.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageStack.Margin" Value="12,8,12,24" />
                        <Setter Target="SettingsTabs.Margin" Value="0" />
                        <Setter Target="StartPagePicker.(Grid.Row)" Value="1" />
                        <Setter Target="StartPagePicker.(Grid.Column)" Value="0" />
                        <Setter Target="StartPagePicker.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="StartPagePicker.Margin" Value="0,10,0,0" />
                        <Setter Target="ThemePicker.(Grid.Row)" Value="1" />
                        <Setter Target="ThemePicker.(Grid.Column)" Value="0" />
                        <Setter Target="ThemePicker.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ThemePicker.Margin" Value="0,10,0,0" />
                        <Setter Target="LanguagePicker.(Grid.Row)" Value="1" />
                        <Setter Target="LanguagePicker.(Grid.Column)" Value="0" />
                        <Setter Target="LanguagePicker.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="LanguagePicker.Margin" Value="0,10,0,0" />
                        <Setter Target="CategoryIntervalPicker.(Grid.Row)" Value="1" />
                        <Setter Target="CategoryIntervalPicker.(Grid.Column)" Value="0" />
                        <Setter Target="CategoryIntervalPicker.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CategoryIntervalPicker.Margin" Value="0,10,0,0" />
                        <Setter Target="DeleteStartPicker.(Grid.Row)" Value="0" />
                        <Setter Target="DeleteStartPicker.(Grid.Column)" Value="0" />
                        <Setter Target="DeleteStartPicker.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DeleteStartPicker.Margin" Value="0" />
                        <Setter Target="DeleteEndPicker.(Grid.Row)" Value="1" />
                        <Setter Target="DeleteEndPicker.(Grid.Column)" Value="0" />
                        <Setter Target="DeleteEndPicker.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DeleteEndPicker.Margin" Value="0,8,0,0" />
                        <Setter Target="DeleteDataButton.(Grid.Row)" Value="2" />
                        <Setter Target="DeleteDataButton.(Grid.Column)" Value="0" />
                        <Setter Target="DeleteDataButton.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DeleteDataButton.Margin" Value="0,10,0,0" />
                        <Setter Target="ExportStartPicker.(Grid.Row)" Value="0" />
                        <Setter Target="ExportStartPicker.(Grid.Column)" Value="0" />
                        <Setter Target="ExportStartPicker.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ExportStartPicker.Margin" Value="0" />
                        <Setter Target="ExportEndPicker.(Grid.Row)" Value="1" />
                        <Setter Target="ExportEndPicker.(Grid.Column)" Value="0" />
                        <Setter Target="ExportEndPicker.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ExportEndPicker.Margin" Value="0,8,0,0" />
                        <Setter Target="ExportDataButton.(Grid.Row)" Value="2" />
                        <Setter Target="ExportDataButton.(Grid.Column)" Value="0" />
                        <Setter Target="ExportDataButton.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ExportDataButton.Margin" Value="0,10,0,0" />
                        <Setter Target="DataActions.Orientation" Value="Vertical" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PageStack" Margin="24,8,28,32" Spacing="20">
                <controls:SelectorBar x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">
                    <controls:SelectorBar.Resources>
                        <StaticResource x:Key="SelectorBarItemPillFill" ResourceKey="TaiAccentBrush" />
                    </controls:SelectorBar.Resources>
                    <controls:SelectorBarItem x:Name="GeneralTab" Text="常规" x:Uid="SettingsPage_001" />
                    <controls:SelectorBarItem x:Name="LinksTab" Text="进程合并" x:Uid="SettingsPage_002" />
                    <controls:SelectorBarItem x:Name="RulesTab" Text="记录规则" x:Uid="SettingsPage_003" />
                    <controls:SelectorBarItem x:Name="DataTab" Text="数据" x:Uid="SettingsPage_004" />
                    <controls:SelectorBarItem x:Name="AboutTab" Text="关于" x:Uid="SettingsPage_005" />
                </controls:SelectorBar>
                <Grid>
                    <StackPanel x:Name="GeneralSection" Spacing="16" Margin="0,12,0,0">
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="基础" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_006" />
                                    <Grid MinHeight="56" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="开机自启动" TextWrapping="Wrap" x:Uid="SettingsPage_007" />
                                            <TextBlock Text="登录 Windows 后自动启动 Tai" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_008" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartAtBootToggle" Grid.Column="1" Style="{StaticResource TaiSettingToggleStyle}" Toggled="GeneralSetting_Toggled" />
                                    </Grid>
                                    <Grid MinHeight="56" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="启动时显示窗口" TextWrapping="Wrap" x:Uid="SettingsPage_009" />
                                            <TextBlock Text="打开 Tai 时同时显示主界面" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_010" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartupShowToggle" Grid.Column="1" Style="{StaticResource TaiSettingToggleStyle}" Toggled="GeneralSetting_Toggled" />
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启动页" x:Uid="SettingsPage_011" />
                                            <TextBlock Text="设置打开主界面时显示的页面" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_012" />
                                        </StackPanel>
                                        <ComboBox x:Name="StartPagePicker" Grid.Column="1" MinWidth="150" SelectedIndex="0" SelectionChanged="GeneralSetting_SelectionChanged">
                                            <ComboBoxItem Content="概览" x:Uid="SettingsPage_013" /><ComboBoxItem Content="统计" x:Uid="SettingsPage_014" /><ComboBoxItem Content="详细" x:Uid="SettingsPage_015" /><ComboBoxItem Content="分类" x:Uid="SettingsPage_016" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="外观" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_017" />
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="主题模式" x:Uid="SettingsPage_018" />
                                            <TextBlock Text="跟随 Windows 或手动选择显示模式" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_019" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemePicker" Grid.Column="1" MinWidth="150" SelectedIndex="0" SelectionChanged="GeneralSetting_SelectionChanged">
                                            <ComboBoxItem Content="浅色" x:Uid="SettingsPage_020" /><ComboBoxItem Content="深色" x:Uid="SettingsPage_021" /><ComboBoxItem Content="跟随 Windows" x:Uid="SettingsPage_022" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="语言" x:Uid="SettingsPage_023" />
                                            <TextBlock Text="跟随系统语言或手动选择" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_024" />
                                        </StackPanel>
                                        <ComboBox x:Name="LanguagePicker" Grid.Column="1" MinWidth="150" SelectionChanged="LanguagePicker_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" x:Uid="SettingsPage_025" />
                                            <ComboBoxItem Content="简体中文" x:Uid="SettingsPage_026" />
                                            <ComboBoxItem Content="English" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid MinHeight="56" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="记住窗口大小" TextWrapping="Wrap" x:Uid="SettingsPage_027" />
                                            <TextBlock Text="下次打开时恢复当前窗口尺寸" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_028" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SaveWindowSizeToggle" Grid.Column="1" Style="{StaticResource TaiSettingToggleStyle}" Toggled="GeneralSetting_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="概览页" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_029" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="首页常用排行条数" x:Uid="SettingsPage_030" />
                                            <TextBlock Text="控制概览页展示的应用和网站数量" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_031" />
                                        </StackPanel>
                                        <ComboBox x:Name="FrequentCountPicker" Grid.Column="1" MinWidth="100" SelectionChanged="GeneralSetting_SelectionChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="应用分类" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_032" />
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="自动获取间隔" x:Uid="SettingsPage_033" />
                                            <TextBlock Text="从 GitHub 获取默认应用分类" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_034" />
                                        </StackPanel>
                                        <ComboBox x:Name="CategoryIntervalPicker" Grid.Column="1" MinWidth="150" SelectionChanged="GeneralSetting_SelectionChanged">
                                            <ComboBoxItem Content="关闭" x:Uid="SettingsPage_035" />
                                            <ComboBoxItem Content="每 6 小时" x:Uid="SettingsPage_036" />
                                            <ComboBoxItem Content="每 12 小时" x:Uid="SettingsPage_037" />
                                            <ComboBoxItem Content="每天" x:Uid="SettingsPage_038" />
                                            <ComboBoxItem Content="每 3 天" x:Uid="SettingsPage_039" />
                                            <ComboBoxItem Content="每周" x:Uid="SettingsPage_040" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="功能" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_041" />
                                    <Grid MinHeight="64" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="网站浏览统计" TextWrapping="Wrap" x:Uid="SettingsPage_042" />
                                            <TextBlock Text="需要安装并连接 Chrome 或 Edge 浏览器插件" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_043" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="WebEnabledToggle" Grid.Column="1" Style="{StaticResource TaiSettingToggleStyle}" Toggled="GeneralSetting_Toggled" />
                                    </Grid>
                                    <TextBlock Text="安装网站统计扩展" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_044" />
                                    <TextBlock Text="安装 Tai Sentry 后开启网站浏览统计。" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_045" />
                                    <HyperlinkButton Content="打开 Chrome 网上应用店安装 Tai Sentry" NavigateUri="https://chromewebstore.google.com/detail/tai-sentry/fmjgafoilnpanbpgdkljkjfjgainboim" HorizontalAlignment="Left" Style="{StaticResource TaiLinkButtonStyle}" x:Uid="SettingsPage_046" />
                                </StackPanel>
                            </Border>
                    </StackPanel>

                    <StackPanel x:Name="LinksSection" Margin="0,12,0,0" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="将多个进程关联为一个统计项目，任意一个进程运行时都会同步记录。" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_047" />
                            <StackPanel x:Name="LinksPanel" Spacing="12" />
                            <Button Content="新建关联" HorizontalAlignment="Left" Click="AddLink_Click" Style="{StaticResource TaiPrimaryButtonStyle}" x:Uid="SettingsPage_048" />
                    </StackPanel>

                    <StackPanel x:Name="RulesSection" Margin="0,12,0,0" Spacing="16" Visibility="Collapsed">
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="偏好" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_049" />
                                    <ToggleSwitch x:Name="SleepWatchToggle" Header="睡眠监测" Style="{StaticResource TaiSettingToggleStyle}" Toggled="BehaviorSetting_Toggled" x:Uid="SettingsPage_050" />
                                    <TextBlock Text="离开电脑时自动停止统计，重启软件生效。" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_051" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="忽略应用" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_052" />
                                    <TextBlock Text="通过进程名称或正则表达式过滤不需要统计的应用。" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_053" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="IgnoreProcessInput" PlaceholderText="进程名称，不需要输入 .exe" x:Uid="SettingsPage_054" />
                                        <Button Grid.Column="1" Content="添加" Click="AddIgnoreProcess_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_055" />
                                    </Grid>
                                    <ListView x:Name="IgnoreProcessList" MaxHeight="180" SelectionMode="Single" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="移除选中" Click="RemoveIgnoreProcess_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_056" />
                                        <Button Content="导入" Tag="IgnoreProcessList" Click="ImportList_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_057" />
                                        <Button Content="导出" Tag="IgnoreProcessList" Click="ExportList_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_058" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="忽略 URL" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_059" />
                                    <TextBlock Text="过滤不需要统计的网站或链接，支持正则表达式。" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_060" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="IgnoreUrlInput" PlaceholderText="URL 支持正则表达式" x:Uid="SettingsPage_061" />
                                        <Button Grid.Column="1" Content="添加" Click="AddIgnoreUrl_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_062" />
                                    </Grid>
                                    <ListView x:Name="IgnoreUrlList" MaxHeight="180" SelectionMode="Single" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="移除选中" Click="RemoveIgnoreUrl_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_063" />
                                        <Button Content="导入" Tag="IgnoreUrlList" Click="ImportList_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_064" />
                                        <Button Content="导出" Tag="IgnoreUrlList" Click="ExportList_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_065" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="12">
                                    <ToggleSwitch x:Name="WhiteListToggle" Header="应用白名单" Style="{StaticResource TaiSettingToggleStyle}" Toggled="BehaviorSetting_Toggled" x:Uid="SettingsPage_066" />
                                    <TextBlock Text="启用后仅统计白名单内的应用。" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_067" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="WhiteListInput" PlaceholderText="进程名称，不需要输入 .exe" x:Uid="SettingsPage_068" />
                                        <Button Grid.Column="1" Content="添加" Click="AddWhiteList_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_069" />
                                    </Grid>
                                    <ListView x:Name="WhiteList" MaxHeight="180" SelectionMode="Single" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="移除选中" Click="RemoveWhiteList_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_070" />
                                        <Button Content="导入" Tag="WhiteList" Click="ImportList_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_071" />
                                        <Button Content="导出" Tag="WhiteList" Click="ExportList_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_072" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                    </StackPanel>

                    <StackPanel x:Name="DataSection" Margin="0,12,0,0" Spacing="16" Visibility="Collapsed">
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="删除数据" Foreground="{StaticResource TaiDangerBrush}" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_073" />
                                    <TextBlock Text="删除所选月份范围内的应用和网站统计数据，此操作不可恢复。" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_074" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <CalendarDatePicker x:Name="DeleteStartPicker" PlaceholderText="开始月份" HorizontalAlignment="Stretch" x:Uid="SettingsPage_075" />
                                        <CalendarDatePicker x:Name="DeleteEndPicker" Grid.Column="1" PlaceholderText="结束月份" HorizontalAlignment="Stretch" x:Uid="SettingsPage_076" />
                                        <Button x:Name="DeleteDataButton" Grid.Column="2" Content="执行删除" Click="DeleteData_Click" Style="{StaticResource TaiDangerButtonStyle}" x:Uid="SettingsPage_077" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="导出数据" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_078" />
                                    <TextBlock Text="导出为 xlsx 和 csv 格式。" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_079" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <CalendarDatePicker x:Name="ExportStartPicker" PlaceholderText="开始月份" HorizontalAlignment="Stretch" x:Uid="SettingsPage_080" />
                                        <CalendarDatePicker x:Name="ExportEndPicker" Grid.Column="1" PlaceholderText="结束月份" HorizontalAlignment="Stretch" x:Uid="SettingsPage_081" />
                                        <Button x:Name="ExportDataButton" Grid.Column="2" Content="导出数据" Click="ExportData_Click" Style="{StaticResource TaiPrimaryButtonStyle}" x:Uid="SettingsPage_082" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaiCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="导入数据" Style="{StaticResource TaiSectionTitleStyle}" x:Uid="SettingsPage_083" />
                                    <TextBlock Text="导入 Tai 的 SQLite 数据库文件。导入前会自动备份当前数据库。" TextWrapping="Wrap" Style="{StaticResource TaiCaptionStyle}" x:Uid="SettingsPage_084" />
                                    <StackPanel x:Name="DataActions" Orientation="Horizontal" Spacing="10">
                                        <Button Content="导入数据库" Click="ImportData_Click" Style="{StaticResource TaiPrimaryButtonStyle}" x:Uid="SettingsPage_085" />
                                        <Button Content="导出配置" Click="ExportConfig_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_086" />
                                        <Button Content="导入配置" Click="ImportConfig_Click" Style="{StaticResource TaiSubtleButtonStyle}" x:Uid="SettingsPage_087" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                    </StackPanel>

                    <Border x:Name="AboutSection" Margin="0,12,0,0" Style="{StaticResource TaiCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <Image x:Name="SettingsLogo" Source="ms-appx:///Resources/Icons/tai.png" Width="48" Height="48" HorizontalAlignment="Left" />
