<Page
    x:Class="Tai.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid>
    <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageStack.Margin" Value="24,8,28,32" />
                            <Setter Target="ThemePicker.(Grid.Row)" Value="0" /><Setter Target="ThemePicker.HorizontalAlignment" Value="Right" /><Setter Target="ThemePicker.Margin" Value="0" />
                            <Setter Target="AccentPicker.(Grid.Row)" Value="0" /><Setter Target="AccentPicker.HorizontalAlignment" Value="Right" /><Setter Target="AccentPicker.Margin" Value="0" />
                            <Setter Target="StorageStatus.(Grid.Row)" Value="0" /><Setter Target="StorageStatus.HorizontalAlignment" Value="Right" /><Setter Target="StorageStatus.Margin" Value="0" />
                            <Setter Target="DataActions.Orientation" Value="Horizontal" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageStack.Margin" Value="12,8,12,24" />
                            <Setter Target="ThemePicker.(Grid.Row)" Value="1" /><Setter Target="ThemePicker.HorizontalAlignment" Value="Left" /><Setter Target="ThemePicker.Margin" Value="0,12,0,0" />
                            <Setter Target="AccentPicker.(Grid.Row)" Value="1" /><Setter Target="AccentPicker.HorizontalAlignment" Value="Left" /><Setter Target="AccentPicker.Margin" Value="0,12,0,0" />
                            <Setter Target="StorageStatus.(Grid.Row)" Value="1" /><Setter Target="StorageStatus.HorizontalAlignment" Value="Left" /><Setter Target="StorageStatus.Margin" Value="0,10,0,0" />
                            <Setter Target="DataActions.Orientation" Value="Vertical" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageStack" Margin="24,8,28,32" Spacing="20">
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource TaiPageTitleStyle}" />
                <TextBlock Text="调整 Tai 的运行方式、数据管理和外观。" Margin="0,5,0,0" Style="{StaticResource TaiCaptionStyle}" />
            </StackPanel>

            <Border Style="{StaticResource TaiCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="常规" Style="{StaticResource TaiSectionTitleStyle}" />
                    <ToggleSwitch Header="开机时启动 Tai" IsOn="True" />
                    <ToggleSwitch Header="启动时打开主窗口" IsOn="True" />
                    <ToggleSwitch Header="显示任务栏通知" IsOn="True" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TaiCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="外观" Style="{StaticResource TaiSectionTitleStyle}" />
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="应用主题" />
                            <TextBlock Text="跟随 Windows 的浅色或深色模式" Margin="0,4,0,0" Style="{StaticResource TaiCaptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemePicker" SelectedIndex="0" MinWidth="150" HorizontalAlignment="Right">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="强调色" />
                            <TextBlock Text="用于导航、按钮和图表" Margin="0,4,0,0" Style="{StaticResource TaiCaptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="AccentPicker" SelectedIndex="0" MinWidth="150" HorizontalAlignment="Right">
                            <ComboBoxItem Content="薄荷绿" />
                            <ComboBoxItem Content="靛蓝" />
                            <ComboBoxItem Content="琥珀" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TaiCardStyle}">
                <StackPanel Spacing="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource TaiSectionTitleStyle}" />
                            <TextBlock Text="数据保存在本地，不会自动上传。" Margin="0,4,0,0" Style="{StaticResource TaiCaptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="StorageStatus" Text="本地 SQLite" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TaiAccentBrush}" />
                    </Grid>
                    <StackPanel x:Name="DataActions" Orientation="Horizontal" Spacing="10">
                        <Button Content="导出数据" Style="{StaticResource TaiPrimaryButtonStyle}" />
                        <Button Content="清理历史数据" Style="{StaticResource TaiDangerButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TaiCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于 Tai" Style="{StaticResource TaiSectionTitleStyle}" />
                    <TextBlock Text="版本 1.0.0 · 使用 WinUI 3 重构" Style="{StaticResource TaiCaptionStyle}" />
                    <Button Content="检查更新" HorizontalAlignment="Left" Style="{StaticResource TaiSubtleButtonStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
