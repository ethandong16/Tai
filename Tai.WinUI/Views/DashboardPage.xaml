<Page
    x:Class="Tai.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:widgets="using:Tai.WinUI.Controls"
    Background="Transparent">
    <Page.Resources>
        <DataTemplate x:Key="UsageItemTemplate">
            <Grid MinHeight="58" Padding="0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource TaiCardMutedBrush}">
                    <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TaiPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource TaiSecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                    <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="{StaticResource TaiPrimaryTextBrush}" HorizontalAlignment="Right" />
                    <ProgressBar Value="{Binding Percent}" Maximum="100" Width="72" Height="4" Foreground="{Binding Accent}" Background="{StaticResource TaiCardMutedBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageStack.Margin" Value="24,8,28,32" />
                        <Setter Target="RefreshButton.(Grid.Row)" Value="0" />
                        <Setter Target="RefreshButton.HorizontalAlignment" Value="Right" />
                        <Setter Target="RefreshButton.Margin" Value="0" />
                        <Setter Target="HeroPrimaryColumn.Width" Value="1.25*" />
                        <Setter Target="HeroSecondaryColumn.Width" Value="*" />
                        <Setter Target="HeroSecondRow.Height" Value="0" />
                        <Setter Target="HeroGrid.ColumnSpacing" Value="32" />
                        <Setter Target="HeroFacts.(Grid.Row)" Value="0" />
                        <Setter Target="HeroFacts.(Grid.Column)" Value="1" />
                        <Setter Target="HeroFacts.Margin" Value="0" />
                        <Setter Target="UsageColumn1.Width" Value="*" />
                        <Setter Target="UsageColumn2.Width" Value="*" />
                        <Setter Target="UsageRow2.Height" Value="0" />
                        <Setter Target="UsageGrid.ColumnSpacing" Value="28" />
                        <Setter Target="WebsiteSection.(Grid.Row)" Value="0" />
                        <Setter Target="WebsiteSection.(Grid.Column)" Value="1" />
                        <Setter Target="WebsiteSection.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageStack.Margin" Value="12,8,12,24" />
                        <Setter Target="RefreshButton.(Grid.Row)" Value="1" />
                        <Setter Target="RefreshButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="RefreshButton.Margin" Value="0,12,0,0" />
                        <Setter Target="HeroPrimaryColumn.Width" Value="*" />
                        <Setter Target="HeroSecondaryColumn.Width" Value="0" />
                        <Setter Target="HeroSecondRow.Height" Value="Auto" />
                        <Setter Target="HeroGrid.ColumnSpacing" Value="0" />
                        <Setter Target="HeroFacts.(Grid.Row)" Value="1" />
                        <Setter Target="HeroFacts.(Grid.Column)" Value="0" />
                        <Setter Target="HeroFacts.Margin" Value="0,24,0,0" />
                        <Setter Target="UsageColumn1.Width" Value="*" />
                        <Setter Target="UsageColumn2.Width" Value="0" />
                        <Setter Target="UsageRow2.Height" Value="Auto" />
                        <Setter Target="UsageGrid.ColumnSpacing" Value="0" />
                        <Setter Target="WebsiteSection.(Grid.Row)" Value="1" />
                        <Setter Target="WebsiteSection.(Grid.Column)" Value="0" />
                        <Setter Target="WebsiteSection.Margin" Value="0,24,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageStack" Margin="24,8,28,32" Spacing="28">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="今天的使用情况" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                        <TextBlock Text="数据会随 Tai 的记录实时更新" Margin="0,4,0,0" Style="{StaticResource TaiCaptionStyle}" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Grid.Column="1" HorizontalAlignment="Right" Command="{Binding RefreshCommand}" Style="{StaticResource TaiPrimaryButtonStyle}" ToolTipService.ToolTip="刷新概览数据">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Background="{StaticResource TaiCardBackgroundBrush}" BorderBrush="{StaticResource TaiDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                    <Grid x:Name="HeroGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeroPrimaryColumn" Width="1.25*" />
                            <ColumnDefinition x:Name="HeroSecondaryColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="HeroSecondRow" Height="0" /></Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="今天用了多久" Style="{StaticResource TaiCaptionStyle}" />
                            <TextBlock Text="{Binding TodayUsage}" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                            <TextBlock Text="应用使用总时长" Style="{StaticResource TaiCaptionStyle}" />
                        </StackPanel>
                        <Grid x:Name="HeroFacts" Grid.Column="1" ColumnSpacing="20" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="应用" Style="{StaticResource TaiCaptionStyle}" />
                                <TextBlock Text="{Binding AppCountText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="网站" Style="{StaticResource TaiCaptionStyle}" />
                                <TextBlock Text="{Binding WebsiteCountText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="最长使用" Style="{StaticResource TaiCaptionStyle}" />
                                <TextBlock Text="{Binding LongestAppName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LongestAppDuration}" Style="{StaticResource TaiCaptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="UsageGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="UsageColumn1" Width="*" />
                        <ColumnDefinition x:Name="UsageColumn2" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="UsageRow2" Height="0" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Grid Padding="0,0,0,10" BorderBrush="{StaticResource TaiDividerBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="最近应用" Style="{StaticResource TaiSectionTitleStyle}" />
                                <TextBlock Text="今天按使用时长排序" Margin="0,3,0,0" Style="{StaticResource TaiCaptionStyle}" />
                            </StackPanel>
                            <Button x:Name="AppViewButton" HorizontalAlignment="Right" Click="ViewAll_Click" Style="{StaticResource TaiSubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="查看全部" /><FontIcon Glyph="&#xE76C;" FontSize="12" /></StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource UsageItemTemplate}" />
                    </StackPanel>
                    <StackPanel x:Name="WebsiteSection" Grid.Column="1">
                        <Grid Padding="0,0,0,10" BorderBrush="{StaticResource TaiDividerBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="最近网站" Style="{StaticResource TaiSectionTitleStyle}" />
                                <TextBlock Text="今日浏览记录" Margin="0,3,0,0" Style="{StaticResource TaiCaptionStyle}" />
                            </StackPanel>
                            <Button x:Name="WebsiteViewButton" HorizontalAlignment="Right" Click="ViewAll_Click" Style="{StaticResource TaiSubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="查看全部" /><FontIcon Glyph="&#xE76C;" FontSize="12" /></StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Websites}" ItemTemplate="{StaticResource UsageItemTemplate}" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="14">
                    <Grid Padding="0,0,0,10" BorderBrush="{StaticResource TaiDividerBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="本周趋势" Style="{StaticResource TaiSectionTitleStyle}" />
                            <TextBlock Text="{Binding RangeText}" Margin="0,3,0,0" Style="{StaticResource TaiCaptionStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastUpdated}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TaiCaptionStyle}" />
                    </Grid>
                    <widgets:UsageTrendChart Items="{Binding Trend}" Height="230" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
