<Page
    x:Class="Tai.WinUI.Views.WebsiteDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageStack.Margin" Value="24,8,28,32" />
                        <Setter Target="SummaryColumn3.Width" Value="Auto" />
                        <Setter Target="SummaryRow2.Height" Value="0" />
                        <Setter Target="DurationPanel.(Grid.Row)" Value="0" />
                        <Setter Target="DurationPanel.(Grid.Column)" Value="2" />
                        <Setter Target="DurationPanel.HorizontalAlignment" Value="Right" />
                        <Setter Target="DurationPanel.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageStack.Margin" Value="12,8,12,24" />
                        <Setter Target="SummaryColumn3.Width" Value="0" />
                        <Setter Target="SummaryRow2.Height" Value="Auto" />
                        <Setter Target="DurationPanel.(Grid.Row)" Value="1" />
                        <Setter Target="DurationPanel.(Grid.Column)" Value="1" />
                        <Setter Target="DurationPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="DurationPanel.Margin" Value="14,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PageStack" Margin="24,8,28,32" Spacing="24">
                <Button HorizontalAlignment="Left" Click="Back_Click" Style="{StaticResource TaiSubtleButtonStyle}" ToolTipService.ToolTip="返回详细">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel>
                    <TextBlock Text="网站详情" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                    <TextBlock Text="所选统计范围内的网站浏览信息。" Margin="0,4,0,0" Style="{StaticResource TaiCaptionStyle}" />
                </StackPanel>
                <Border Style="{StaticResource TaiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SummaryColumn3" Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SummaryRow2" Height="0" /></Grid.RowDefinitions>
                        <Border Width="54" Height="54" CornerRadius="8" Background="{StaticResource TaiCardMutedBrush}">
                            <Image Source="{Binding Icon}" Width="42" Height="42" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="网站 ·" Style="{StaticResource TaiCaptionStyle}" />
                                <TextBlock Text="{Binding Category}" Style="{StaticResource TaiCaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="DurationPanel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Duration}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TaiAccentBrush}" />
                            <TextBlock Text="所选范围" Style="{StaticResource TaiCaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Spacing="14">
                    <TextBlock Text="浏览概览" Style="{StaticResource TaiSectionTitleStyle}" />
                    <Grid Padding="0,12" BorderBrush="{StaticResource TaiDividerBrush}" BorderThickness="0,1,0,1">
                        <TextBlock Text="所属分类" Style="{StaticResource TaiCaptionStyle}" />
                        <TextBlock Text="{Binding Category}" HorizontalAlignment="Right" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="范围内相对占比" Style="{StaticResource TaiCaptionStyle}" />
                        <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Right" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                    </Grid>
                    <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" Foreground="{Binding AccentBrush}" Background="{StaticResource TaiCardMutedBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
