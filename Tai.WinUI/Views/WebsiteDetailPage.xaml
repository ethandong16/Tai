<Page
    x:Class="Tai.WinUI.Views.WebsiteDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,8,28,32" Spacing="20">
            <Button Content="返回详细" HorizontalAlignment="Left" Click="Back_Click" Style="{StaticResource TaiSubtleButtonStyle}" />
            <StackPanel>
                <TextBlock Text="网站详情" Style="{StaticResource TaiPageTitleStyle}" />
                <TextBlock Text="查看站点浏览时长和访问趋势。" Margin="0,5,0,0" Style="{StaticResource TaiCaptionStyle}" />
            </StackPanel>
            <Border Background="{StaticResource TaiAccentSoftBrush}" BorderBrush="#C8E8DD" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="14" Background="{Binding AccentBrush}">
                        <FontIcon Glyph="{Binding Glyph}" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                        <TextBlock Text="网站 · 浏览记录" Style="{StaticResource TaiCaptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Duration}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TaiAccentBrush}" />
                        <TextBlock Text="今日浏览" Style="{StaticResource TaiCaptionStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource TaiCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="浏览趋势" Style="{StaticResource TaiSectionTitleStyle}" />
                    <Grid Height="180" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="20">
                            <Rectangle Width="44" Height="62" Fill="{StaticResource TaiAccentBrush}" RadiusX="5" RadiusY="5" />
                            <Rectangle Width="44" Height="110" Fill="{StaticResource TaiAccentBrush}" RadiusX="5" RadiusY="5" />
                            <Rectangle Width="44" Height="84" Fill="{StaticResource TaiAccentBrush}" RadiusX="5" RadiusY="5" />
                            <Rectangle Width="44" Height="145" Fill="{StaticResource TaiAccentBrush}" RadiusX="5" RadiusY="5" />
                            <Rectangle Width="44" Height="96" Fill="{StaticResource TaiAccentBrush}" RadiusX="5" RadiusY="5" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="周一        周二        周三        周四        周五" HorizontalAlignment="Center" Style="{StaticResource TaiCaptionStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
