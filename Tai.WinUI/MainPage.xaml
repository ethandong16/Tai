<Page
    x:Class="Tai.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:Tai.WinUI.Views"
    Background="{StaticResource TaiPageBackgroundBrush}">
    <Grid x:Name="LayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootNavigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="RootNavigation.IsPaneOpen" Value="True" />
                        <Setter Target="RootNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="PageHeader.Margin" Value="24,20,24,12" />
                        <Setter Target="PageHeader.Padding" Value="0,0,0,16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="640" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootNavigation.PaneDisplayMode" Value="LeftCompact" />
                        <Setter Target="RootNavigation.IsPaneOpen" Value="False" />
                        <Setter Target="RootNavigation.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="PageHeader.Margin" Value="20,16,20,10" />
                        <Setter Target="PageHeader.Padding" Value="0,0,0,16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootNavigation.PaneDisplayMode" Value="LeftMinimal" />
                        <Setter Target="RootNavigation.IsPaneOpen" Value="False" />
                        <Setter Target="RootNavigation.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="PageHeader.Margin" Value="12,12,12,8" />
                        <Setter Target="PageHeader.Padding" Value="44,0,0,16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <controls:NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="False"
            OpenPaneLength="208"
            CompactPaneLength="56"
            PaneDisplayMode="LeftMinimal"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="RootNavigation_SelectionChanged"
            Background="Transparent">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="概览" Tag="Dashboard">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="统计" Tag="Statistics">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="FourBars" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="详细" Tag="Details">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="分类" Tag="Categories">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>
            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem Content="设置" Tag="Settings">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.FooterMenuItems>

            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="PageHeader" Grid.Row="0" Margin="12,12,12,8" Padding="0,0,0,16" BorderBrush="{StaticResource TaiDividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="时间使用" FontSize="12" Foreground="{StaticResource TaiSecondaryTextBrush}" />
                        <TextBlock x:Name="PageTitle" Text="概览" Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TaiPrimaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="ContentFrame_Navigated" />
            </Grid>
        </controls:NavigationView>
    </Grid>
</Page>
